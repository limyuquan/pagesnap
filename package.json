{
  "name": "pagesnap",
  "displayName": "Page Snap",
  "description": "Full-page screenshots with an instant annotation editor. Copy the marked-up image straight into an AI chat.",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "build:e2e": "wxt build --mode e2e",
    "zip": "wxt zip",
    "typecheck": "wxt prepare && tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:browser": "vitest run --project browser",
    "test:e2e": "pnpm build:e2e && playwright test",
    "test:e2e:cft": "pnpm build:e2e && PAGESNAP_BROWSER=cft playwright test",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "idb": "8.0.4",
    "perfect-freehand": "1.2.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.5",
    "@types/pngjs": "6.0.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/browser-playwright": "5.0.5",
    "@wxt-dev/module-react": "1.2.2",
    "fake-indexeddb": "6.2.6",
    "playwright": "1.64.1",
    "pngjs": "7.0.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "wxt": "0.21.4"
  }
}
